+  void popRHSifTop(const BinaryOperator *E) {
+    if (!OrRHS.empty() && CondIDs[E] == OrRHS.back())
+      OrRHS.pop_back();
+    else if (!AndRHS.empty() && CondIDs[E] == AndRHS.back())
+      AndRHS.pop_back();
+  }
